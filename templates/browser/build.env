# Build-time sizing for the browser template, sourced by templates/build.sh.
# `:=` means an explicitly exported value still wins:
#   sudo -E env VM_MEM_SIZE_MIB=2048 ./templates/build.sh browser
# Chromium needs far more than the 128 MiB / 1 vCPU defaults; with them it boots
# and is then killed by the host cgroup on the first page load.
: "${ROOTFS_SIZE:=2048}"
: "${VM_VCPU_COUNT:=2}"
: "${VM_MEM_SIZE_MIB:=1024}"
: "${VM_MEMORY_LIMIT_BYTES:=1610612736}"
: "${VM_CPU_QUOTA_US:=200000}"
: "${VM_NOFILE_LIMIT:=8192}"
: "${VM_PIDS_LIMIT:=512}"
