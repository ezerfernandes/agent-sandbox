# Build-time sizing for the desktop template, sourced by templates/build.sh.
# `:=` means an explicitly exported value still wins:
#   sudo -E env VM_MEM_SIZE_MIB=2048 ./templates/build.sh desktop
# Xvnc + openbox + Chromium need materially more than the browser template: the
# framebuffer alone is DESKTOP_GEOMETRY x 24bpp, held for the life of the VM.
: "${ROOTFS_SIZE:=2048}"
: "${VM_VCPU_COUNT:=2}"
: "${VM_MEM_SIZE_MIB:=1536}"
: "${VM_MEMORY_LIMIT_BYTES:=2147483648}"
: "${VM_CPU_QUOTA_US:=200000}"
: "${VM_NOFILE_LIMIT:=8192}"
: "${VM_PIDS_LIMIT:=512}"
